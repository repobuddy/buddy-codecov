{
	"name": "buddy-codecov",
	"version": "0.0.0",
	"description": "Codecov coverage comparison skill for AI coding agents",
	"keywords": [
		"buddy-codecov-plugin",
		"codecov",
		"coverage",
		"agent"
	],
	"license": "MIT",
	"author": {
		"name": "repobuddy"
	},
	"type": "module",
	"bin": {
		"buddy-codecov": "./bin/buddy-codecov.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"bin",
		"dist",
		"src",
		"skills",
		"plugin.json",
		".plugin",
		".claude-plugin",
		".cursor-plugin",
		".codex-plugin"
	],
	"scripts": {
		"build": "tsdown",
		"coverage": "vitest run --coverage",
		"dev": "tsx src/cli.ts",
		"prepack": "pnpm build",
		"test": "vitest run",
		"test:dist": "tsc --noEmit -p tsconfig.dist.json && vitest run --config vitest.dist.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@toon-format/toon": "^4.1.1",
		"clibuilder": "^9.1.0"
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"@vitest/coverage-v8": "^4.1.0",
		"tsdown": "^0.22.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.0"
	}
}

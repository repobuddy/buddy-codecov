{
	"name": "buddy-codecov-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"bc": "pnpm --filter ./packages/buddy-codecov",
		"check": "biome check",
		"check:fix": "biome check --write",
		"coverage": "turbo run coverage",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"verify": "pnpm check && pnpm test",
		"version": "changeset version && node scripts/sync-plugin-version.mjs",
		"web": "pnpm --filter website"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^2.31.1",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"turbo": "^2.10.8"
	},
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=22"
	}
}
